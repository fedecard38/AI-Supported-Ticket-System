# =================================================================
# AI-Supported Ticket System - Environment Configuration
# =================================================================

# --- Application Environment ---
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticket_system
POSTGRES_PORT=5432

# --- Backend Service ---
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ticket_system

# --- Email & SMTP (MailDev) ---
SMTP_HOST=maildev
SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
SMTP_FROM_EMAIL=noreply@ticketworkspace.com

# --- Frontend Service ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
